{
  "manifest_version": 3,
  "name": "Policy Guard",
  "version": "0.1.0",
  "description": "Highlights important terms and privacy concerns before you agree.",

  "permissions": [
    "activeTab"
  ],

  "action": {
    "default_title": "Policy Guard",
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content.js"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "policyguard@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
